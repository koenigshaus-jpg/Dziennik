# --- Sesja (auth obecnie wyłączony, ale env zachowane na przyszłość) ---
APP_PASSWORD=zmien-mnie
SESSION_SECRET=wygeneruj-losowy-ciag-min-32-znakow

# --- Produkcja: Turso (libSQL) + Vercel Blob ---
# Lokalnie zostaw puste — wtedy używany jest plik data/dziennik.db i public/uploads/

# Turso (https://turso.tech):
#   turso db create dziennik
#   turso db show dziennik --url
#   turso db tokens create dziennik
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob:
# Dashboard → Storage → Create Blob → Connect to Project.
# Token zostanie automatycznie wstrzyknięty w produkcji.
# Lokalnie: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=
