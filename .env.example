# --- Sesja (auth obecnie wyłączony, ale env zachowane na przyszłość) ---
APP_PASSWORD=zmien-mnie
SESSION_SECRET=wygeneruj-losowy-ciag-min-32-znakow

# --- Produkcja: Turso (libSQL) + Vercel Blob ---
# Lokalnie zostaw puste — wtedy używany jest plik data/dziennik.db i public/uploads/

# Turso (https://turso.tech):
#   turso db create dziennik
#   turso db show dziennik --url
#   turso db tokens create dziennik
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob:
# Dashboard → Storage → Create Blob → Connect to Project.
# Token zostanie automatycznie wstrzyknięty w produkcji.
# Lokalnie: vercel env pull .env.local
BLOB_READ_WRITE_TOKEN=

# --- Wspólne konto gościa ---
# Przycisk „Wejdź jako gość" loguje na to jedno, współdzielone konto e-mail/hasło.
# Wszyscy goście widzą te same wpisy i mogą dokładać własne. Puste = domyślne
# (gosc@dziennik.local / dziennik-gosc). Konto zakłada się samo przy 1. wejściu.
NEXT_PUBLIC_GUEST_EMAIL=
NEXT_PUBLIC_GUEST_PASSWORD=

# --- OpenAI: Speech-to-Text (dyktowanie) ---
# Wygeneruj klucz na https://platform.openai.com/api-keys
# Używany model: gpt-4o-mini-transcribe (najtańszy ~$0.003/min)
OPENAI_API_KEY=

# --- Sklep: headless WooCommerce (server-only) ---
# Backend WooCommerce (osobny WordPress, np. na seohost). Klucze: WooCommerce →
# Ustawienia → Zaawansowane → REST API → Dodaj klucz (uprawnienia Read/Write).
WOOCOMMERCE_URL=https://sklep.example.pl
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...

# --- Stripe (subskrypcje konsultantów; server-only) ---
# sk_test_... (tryb test) / sk_live_... (produkcja). Webhook secret: whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- WooCommerce webhook (auto-sync ceny → Stripe; server-only) ---
# Sekret HMAC współdzielony z webhookiem WC (product.updated → /api/woo/webhook).
WC_WEBHOOK_SECRET=

# --- PostHog: analityka użytkowania (TYLKO gałąź `eksperyment`) ---
# Project API Key z PostHog → Settings → Project → Project API Key (zaczyna się od "phc_").
# Bezpieczny do wystawienia w kliencie (stąd NEXT_PUBLIC_). Puste = PostHog nieaktywny.
NEXT_PUBLIC_POSTHOG_KEY=
# Region jest zaszyty w reverse proxy (rewrites `/ingest` w next.config.ts) — domyślnie EU.
# Klient używa api_host="/ingest", więc poniższa zmienna jest już tylko informacyjna.
# Zmiana regionu na US = podmiana hostów eu-assets/eu.i.posthog.com w next.config.ts.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
